rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.email.matches('.*@jdwave\\.app$')
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDailyFreeConfig(data) {
      return data.dateKey is string && data.dateKey.size() <= 20 &&
             data.storyId is string && data.storyId.size() <= 128 &&
             data.episodeId is string && data.episodeId.size() <= 128 &&
             data.active is bool &&
             data.unlockTimeUtcEpochMs is int;
    }

    // Public / App Configuration (Daily Free 6 AM IST schedule)
    match /admin_configs/daily_free {
      // Anyone (Guests & Members) can read the active daily free schedule to know today's unlocked episode
      allow get: if true;
      // Only authorized Admins can write / replace the daily free configuration
      allow write: if isAdmin() && isValidDailyFreeConfig(incoming());
    }

    // User data sandbox
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /progress/{episodeId} {
        allow read, write: if isOwner(userId) && isValidId(episodeId);
      }

      match /favorites/{storyId} {
        allow read, write: if isOwner(userId) && isValidId(storyId);
      }

      match /bookmarks/{bookmarkId} {
        allow read, write: if isOwner(userId) && isValidId(bookmarkId);
      }
    }
  }
}
